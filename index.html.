
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NeuralPath AI | Master Artificial Intelligence</title>

    <meta name="description"
          content="Learn AI tools, programming, automation and machine learning with NeuralPath AI.">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #080b16;
            --surface: #111729;
            --primary: #7c5cff;
            --blue: #4c9aff;
            --text: #f5f7ff;
            --muted: #a4adc4;
            --border: rgba(255,255,255,0.09);
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: auto;
        }

        /* NAVIGATION */

        nav {
            border-bottom: 1px solid var(--border);
            padding: 20px 0;
        }

        .nav-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .logo {
            font-size: 23px;
            font-weight: bold;
        }

        .logo span {
            color: var(--primary);
        }

        .nav-links {
            display: flex;
            gap: 28px;
            align-items: center;
        }

        .nav-links a {
            color: var(--muted);
            font-size: 14px;
        }

        .nav-links a:hover {
            color: white;
        }

        .nav-button {
            background: var(--primary);
            padding: 10px 18px;
            border-radius: 8px;
            color: white !important;
        }

        /* HERO SECTION */

        .hero {
            padding: 100px 0 90px;
            text-align: center;
            background:
                radial-gradient(
                    ellipse at top,
                    rgba(124,92,255,0.18),
                    transparent 65%
                );
        }

        .hero-label {
            display: inline-block;
            border: 1px solid var(--border);
            background: rgba(124,92,255,0.1);
            color: #b6a5ff;
            padding: 7px 15px;
            border-radius: 30px;
            font-size: 13px;
            margin-bottom: 25px;
        }

        .hero h1 {
            font-size: clamp(38px, 7vw, 72px);
            line-height: 1.15;
            max-width: 850px;
            margin: 0 auto 25px;
            letter-spacing: -2px;
        }

        .gradient-text {
            background: linear-gradient(
                90deg,
                #a58aff,
                #58b5ff
            );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            color: var(--muted);
            max-width: 650px;
            margin: 0 auto 35px;
            font-size: 17px;
        }

        .hero-buttons {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .button {
            display: inline-block;
            padding: 13px 24px;
            border-radius: 9px;
            font-weight: bold;
            transition: 0.2s;
        }

        .button-primary {
            background: var(--primary);
            color: white;
        }

        .button-primary:hover {
            background: #6945f5;
            transform: translateY(-2px);
        }

        .button-secondary {
            border: 1px solid var(--border);
            color: white;
        }

        .button-secondary:hover {
            background: var(--surface);
        }

        /* STATS */

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            padding: 35px 0;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            text-align: center;
        }

        .stat h3 {
            font-size: 27px;
        }

        .stat p {
            color: var(--muted);
            font-size: 14px;
        }

        /* GENERAL SECTIONS */

        section {
            padding: 80px 0;
        }

        .section-heading {
            text-align: center;
            margin-bottom: 45px;
        }

        .section-heading h2 {
            font-size: clamp(28px, 4vw, 42px);
            margin-bottom: 12px;
        }

        .section-heading p {
            color: var(--muted);
        }

        /* LEARNING PATHS */

        .paths-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .path-card {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 25px;
            border-radius: 15px;
            transition: 0.25s;
        }

        .path-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
        }

        .path-icon {
            font-size: 35px;
            margin-bottom: 18px;
        }

        .path-card h3 {
            margin-bottom: 10px;
        }

        .path-card p {
            color: var(--muted);
            font-size: 14px;
        }

        /* COURSES */

        .courses-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .course-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 15px;
            overflow: hidden;
            transition: 0.25s;
        }

        .course-card:hover {
            transform: translateY(-5px);
            border-color: var(--blue);
        }

        .course-image {
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 65px;
        }

        .course-image.purple {
            background: linear-gradient(135deg, #30205d, #171b39);
        }

        .course-image.blue {
            background: linear-gradient(135deg, #123f69, #171b39);
        }

        .course-image.pink {
            background: linear-gradient(135deg, #5a204d, #171b39);
        }

        .course-content {
            padding: 23px;
        }

        .course-tag {
            color: #b6a5ff;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .course-content h3 {
            margin: 10px 0;
        }

        .course-content p {
            color: var(--muted);
            font-size: 14px;
            margin-bottom: 20px;
        }

        .course-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--border);
            padding-top: 15px;
        }

        .course-price {
            font-size: 20px;
            font-weight: bold;
        }

        .course-footer a {
            color: #a58aff;
            font-size: 14px;
        }

        /* CERTIFICATES */

        .certificate-section {
            background: linear-gradient(
                135deg,
                rgba(124,92,255,0.12),
                rgba(76,154,255,0.06)
            );
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .certificate-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: center;
        }

        .certificate-content h2 {
            font-size: 38px;
            margin-bottom: 20px;
        }

        .certificate-content p {
            color: var(--muted);
            margin-bottom: 25px;
        }

        .certificate-preview {
            background: #f8f8ff;
            color: #18203b;
            padding: 35px;
            border-radius: 12px;
            text-align: center;
            border: 5px solid #d4c9ff;
        }

        .certificate-preview h3 {
            color: #6b4bde;
            font-size: 27px;
            margin: 15px 0;
        }

        .certificate-preview p {
            color: #535b73;
            font-size: 14px;
        }

        .certificate-line {
            width: 70%;
            height: 1px;
            background: #b7b9cc;
            margin: 20px auto;
        }

        /* PRICING */

        .pricing-card {
            max-width: 500px;
            margin: auto;
            padding: 35px;
            background: var(--surface);
            border: 1px solid var(--primary);
            border-radius: 15px;
            text-align: center;
        }

        .pricing-card h3 {
            font-size: 25px;
        }

        .pricing-card p {
            color: var(--muted);
            margin: 15px 0 25px;
        }

        .pricing-card ul {
            list-style: none;
            text-align: left;
            margin-bottom: 30px;
        }

        .pricing-card li {
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
        }

        /* FOOTER */

        footer {
            border-top: 1px solid var(--border);
            padding: 35px 0;
            text-align: center;
        }

        footer p {
            color: var(--muted);
            font-size: 13px;
        }

        /* MOBILE RESPONSIVENESS */

        @media (max-width: 900px) {
            .paths-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .courses-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .certificate-content {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            .nav-content {
                flex-direction: column;
            }

            .nav-links {
                gap: 15px;
                flex-wrap: wrap;
                justify-content: center;
            }

            .nav-links a {
                font-size: 12px;
            }

            .hero {
                padding: 65px 0;
            }

            .hero h1 {
                letter-spacing: -1px;
            }

            .stats {
                gap: 10px;
            }

            .stat h3 {
                font-size: 21px;
            }

            .stat p {
                font-size: 12px;
            }

            .paths-grid,
            .courses-grid {
                grid-template-columns: 1fr;
            }

            section {
                padding: 55px 0;
            }

            .certificate-content h2 {
                font-size: 30px;
            }

            .certificate-preview {
                padding: 20px;
            }
        }
    </style>
</head>

